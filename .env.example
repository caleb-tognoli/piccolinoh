# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# The server the bot runs in; slash commands are registered there
DISCORD_GUILD_ID=

# Signs the links /join hands out (>= 32 chars). Changing it invalidates
# outstanding links. Generate with: openssl rand -hex 32
JOIN_TOKEN_SECRET=

# Public URL of the website, used to build /join links
PUBLIC_BASE_URL=http://localhost:3000

# Optional: Spotify Client Credentials, enables Spotify track/album links in
# /play. Set both or neither. https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# HTTP + WebSocket port
HTTP_PORT=3000

# development | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
