# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register slash commands in this one server only (shows changes
# instantly, handy for development). Leave empty to register them globally so
# the bot works in every server it's invited to; Discord can take up to an hour
# to show new global commands.
DISCORD_GUILD_ID=

# Signs the links /join hands out (>= 32 chars). Changing it invalidates
# outstanding links. Generate with: openssl rand -hex 32
JOIN_TOKEN_SECRET=

# Public URL of the website, used to build /join links
PUBLIC_BASE_URL=http://localhost:3000

# Optional: Spotify Client Credentials, enables Spotify track/album links in
# /play. Set both or neither. https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Folder for piccolinoh.db, which keeps every server's room across restarts
DATA_DIR=data

# HTTP + WebSocket port (outside Docker; the container always uses 3000)
HTTP_PORT=3000

# Docker Compose only: where the host publishes the site, as [address:]port.
# Default 3000 on every interface; 127.0.0.1:3001 keeps it behind a reverse proxy.
PUBLISH=

# development | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
