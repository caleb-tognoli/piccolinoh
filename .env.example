# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the same page
DISCORD_CLIENT_ID=

# Test guild ID for instant per-guild command registration in dev
DISCORD_GUILD_ID=

# YouTube Data API v3 key. See README ("YouTube API key").
YOUTUBE_API_KEY=

# Public URL where the web client is reachable — used to build /session join links
PUBLIC_BASE_URL=http://localhost:3000

# SQLite database path (query + video cache, quota, guild settings)
SQLITE_PATH=./data/piccolinoh.db

# State server port (HTTP + WebSocket)
HTTP_PORT=3000

# development | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
