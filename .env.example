# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the same page
DISCORD_CLIENT_ID=

# Test guild ID for instant per-guild command registration in dev
DISCORD_GUILD_ID=

# development | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Lavalink audio node (see docker-compose.yml) ---
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
