# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the same page
DISCORD_CLIENT_ID=

# Test guild ID for instant per-guild command registration in dev
DISCORD_GUILD_ID=

# Lavalink resolver URL (compose network default). See README ("Lavalink").
LAVALINK_URL=http://lavalink:2333

# Lavalink server password — must match lavalink/application.yml. Pick any
# non-empty string; only the compose network sees it.
LAVALINK_PASSWORD=change-me

# Spotify Client Credentials (optional). Enables Spotify URL support in
# /play (track / album / playlist) via the LavaSrc plugin, and the
# /thisis <artist> command. Both must be set or both empty. Mint at
# https://developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Public URL where the web client is reachable — used to build /session join links
PUBLIC_BASE_URL=http://localhost:3000

# SQLite database path (query + video cache, quota, guild settings)
SQLITE_PATH=./data/piccolinoh.db

# State server port (HTTP + WebSocket)
HTTP_PORT=3000

# development | production
NODE_ENV=development

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
